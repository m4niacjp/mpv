--- a/scripts/rtx-video-auto.lua
+++ b/scripts/rtx-video-auto.lua
@@ -363,6 +363,15 @@

 -- Before reinit_video_chain / first vo_queue_frame. Do not defer().
 mp.add_hook("on_loaded", 50, function()
+    -- The larger D3D11 pool from a 32-frame backstep cache corrupts VP9 with
+    -- RTX HDR on this GPU. Set the file-local limit before decoder creation;
+    -- auto profiles observing video-format run too late. Other files restore
+    -- the configured cache size, and smaller user limits remain unchanged.
+    if mp.get_property("current-tracks/video/codec") == "vp9"
+        and mp.get_property("hwdec") == "d3d11va"
+        and mp.get_property_number("backstep-cache", 0) > 16 then
+        mp.set_property_number("file-local-options/backstep-cache", 16)
+    end
     pip_vsr_scale_cache = nil
     update_filter(true)
 end)
