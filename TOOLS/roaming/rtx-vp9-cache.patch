+-- VP9 workaround must run before decoder initialization and remain file-local.
+-- Preserve smaller/disabled caches and the large cache used by other codecs.
+for _, case in ipairs({
+    { "vp9", "d3d11va", 32, 16 },
+    { "vp9", "d3d11va", 16 },
+    { "vp9", "d3d11va", 8 },
+    { "vp9", "d3d11va", 0 },
+    { "av1", "d3d11va", 32 },
+    { "h264", "d3d11va", 32 },
+    { "vp9", "d3d11va-copy", 32 },
+    { "vp9", "no", 32 },
+}) do
+    local h = new_rtx_harness(nil)
+    h.props["current-tracks/video/codec"] = case[1]
+    h.props["hwdec"] = case[2]
+    h.props["backstep-cache"] = case[3]
+    h.hooks["on_loaded"]()
+    local name = table.concat({case[1], case[2], case[3]}, "/")
+    check(h.props["file-local-options/backstep-cache"] == case[4],
+          name .. ": unexpected file-local cache limit")
+    check(h.props["backstep-cache"] == case[3],
+          name .. ": changed the global cache size")
+    check(has_true_hdr(h), name .. ": workaround disabled RTX HDR")
+end
